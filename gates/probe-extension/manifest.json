{
  "manifest_version": 3,
  "name": "YTS Probe",
  "version": "0.0.1",
  "description": "Throwaway probe. Verifies stable extension ID across profile copies and characterises YouTube watch-page payloads.",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["collector.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
