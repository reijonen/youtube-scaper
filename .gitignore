# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# uv / venv
.venv/

# Runtime state (SPEC-V3: lives outside both Chrome profile dirs, but not source)
data/
run/
*.log

# Disposable and golden Chrome profiles (SPEC-V3: never committed, recreated/maintained locally)
# Anchored to the project root so these don't also match gates/data-dir-template.
/data-dir/
/data-dir-template/

# gates/data-dir is the disposable runtime profile the probe generated; keep
# gates/data-dir-template committed, it's the fixture the probe was built against
gates/data-dir/

# Extension build output (Phase 6). SPEC-V3 loads the extension unpacked
# directly from extension/, not from a subdirectory, so esbuild writes its
# bundles into extension/ itself rather than extension/dist/.
extension/capture.js
extension/collector.js
extension/service-worker.js
extension/*.js.map
extension/node_modules/

# Extension signing key (Phase 6). Private; the extension ID is derived from
# it and is pinned into manifest.json's "key" field and config.EXTENSION_ID,
# so losing this file means generating a new keypair and a new ID. Back it
# up outside the repo.
/keys/

# OS
.DS_Store

# web-ui (SvelteKit project, self-contained; see web-ui/SPEC.md)
web-ui/node_modules/
web-ui/.svelte-kit/
web-ui/avatar-cache/
web-ui/.env
web-ui/.env.*
!web-ui/.env.example
web-ui/.vscode