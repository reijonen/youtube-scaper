{
  "manifest_version": 3,
  "name": "YouTube Scraper",
  "version": "1.0.0",
  "description": "Observes YouTube watch-page recommendation and comment payloads for the local scraper controller. No UI, no user interaction.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage", "alarms", "webNavigation"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["collector.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
